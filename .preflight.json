{
  "ownership": [
    {
      "match": "prefix",
      "path": "src/",
      "owner": "Core"
    },
    {
      "match": "prefix",
      "path": "tests/",
      "owner": "Tests"
    },
    {
      "match": "prefix",
      "path": ".github/workflows/",
      "owner": "CI"
    },
    {
      "match": "path_exact",
      "path": "pyproject.toml",
      "owner": "Packaging"
    },
    {
      "match": "path_exact",
      "path": "README.md",
      "owner": "Docs"
    },
    {
      "match": "path_exact",
      "path": "CHANGELOG.md",
      "owner": "Docs"
    },
    {
      "match": "path_exact",
      "path": "CONTRIBUTING.md",
      "owner": "Docs"
    },
    {
      "match": "path_exact",
      "path": "SECURITY.md",
      "owner": "Security"
    },
    {
      "match": "path_exact",
      "path": "LICENSE",
      "owner": "Repository"
    },
    {
      "match": "path_exact",
      "path": ".gitignore",
      "owner": "Repository"
    },
    {
      "match": "path_exact",
      "path": ".preflight.example.json",
      "owner": "Repository"
    },
    {
      "match": "path_exact",
      "path": ".preflight.json",
      "owner": "Repository"
    }
  ],
  "governance": {
    "critical_escalation": true,
    "critical_unknown_count": 5,
    "critical_unknown_ratio": 0.25
  }
}